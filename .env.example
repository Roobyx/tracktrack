# ═════════════════════════════════════════════════════════════════════════════
# tracktrack self-hosting configuration
#
# Usage
#   • Docker Compose : copy to .env next to docker-compose.yml and adjust.
#   • Portainer      : Stacks → your stack → Environment variables →
#                      Advanced editor → paste this file's content (set real
#                      secrets!) → deploy.
#
# Everything below is consumed through docker-compose.yml interpolation.
# Vars marked (required) must be set for the feature that uses them;
# everything else ships with a working default.
# ═════════════════════════════════════════════════════════════════════════════

# ── Host ports ───────────────────────────────────────────────────────────────
# TrackTrack listens on these ports inside the container too (host == container):
# API server, web GUI and MCP-over-HTTP endpoint respectively.
TRACKTRACK_PORT=4356
TRACKTRACK_WEB_PORT=4357
TRACKTRACK_MCP_PORT=4358

# ── TrackTrack service ───────────────────────────────────────────────────────
# true  → run the standalone web GUI server (apps/tracktrack/dist) on
#         TRACKTRACK_WEB_PORT; it proxies /api/tracktrack to the API server
# false → API + MCP only
TRACKTRACK_WEB=true

# true  → run the MCP-over-HTTP endpoint on TRACKTRACK_MCP_PORT
# false → drop the MCP server
TRACKTRACK_MCP=true

# Override for the web GUI server's API proxy target. Default:
# http://127.0.0.1:$TRACKTRACK_PORT (the API runs in the same container).
#TRACKTRACK_API_URL=

# Primary storage backend: sqlite (default) | s3 | local
#   sqlite → single file on the tracktrack_data volume (recommended)
#   s3     → store everything directly in the S3 bucket below
#   local  → JSON files on the tracktrack_data volume
TRACKTRACK_STORAGE=sqlite

# Optional periodic backup of the primary storage into the S3 bucket
TRACKTRACK_BACKUP_TO_S3=false
TRACKTRACK_BACKUP_INTERVAL_MS=15000

# Default model for TrackTrack AI plan assessments (overridable per request)
TRACKTRACK_ASSESS_MODEL=openrouter/free

# Login session lifetime in days (default 30). Sessions slide forward on use:
# as long as a session is used once per half of its lifetime it never expires.
TRACKTRACK_SESSION_DAYS=30

# Admin PIN for the TrackTrack login (minimum 4 characters). When set it is
# authoritative on every boot: first run creates the admin with it, and later
# changes rotate the stored PIN (invalidating existing admin sessions). Leave
# unset to keep the legacy behavior: a random PIN generated on first run and
# stored in .tracktrack-bootstrap on the data volume.
TRACKTRACK_ADMIN_PIN=change-me-admin-pin

# ── S3 bucket (TrackTrack storage/backup) ────────────────────────────────────
# (required when TRACKTRACK_STORAGE=s3 or TRACKTRACK_BACKUP_TO_S3=true)
# With the embedded s3 profile enabled: http://rustfs:9000
# With an external S3:                e.g. http://your-s3-host:9000
BUCKET_SERVER_ENDPOINT=
BUCKET_ACCESS_KEY=change-me-access-key
BUCKET_SECRET_KEY=change-me-secret-key
BUCKET_NAME=tracktrack
S3_REGION=eu-central-1

# Optional per-service S3 overrides. Leave commented: the server falls back to
# the BUCKET_* values above. Do NOT set them to empty values.
#TRACKTRACK_S3_ENDPOINT=
#TRACKTRACK_S3_ACCESS_KEY=
#TRACKTRACK_S3_SECRET_KEY=
#TRACKTRACK_S3_BUCKET=
#TRACKTRACK_S3_PREFIX=tracktrack/
#TRACKTRACK_S3_REGION=eu-central-1

# Optional TrackTrack storage path overrides (rarely needed)
#TRACKTRACK_SQLITE_PATH=/data/tracktrack.sqlite

# ── Embedded s3 (compose profile "bucket") ────────────────────────────────
# Only used when the embedded RustFS service is enabled: docker compose --profile bucket
# The service reuses BUCKET_ACCESS_KEY / BUCKET_SECRET_KEY from above.
BUCKET_API_PORT=9010
BUCKET_CONSOLE_PORT=9011

# ── AI providers (TrackTrack assessments) ────────────────────────────────────
# At least one key is required for AI features; both are optional otherwise.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENAI_API_KEY=sk-your-openai-key
